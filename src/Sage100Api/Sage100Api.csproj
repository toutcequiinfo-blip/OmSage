<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API REST (.NET 8, 64 bits). Lectures en SQL (lecture seule), écritures déléguées au worker Objets Métiers. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sage100Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sage100Api.Contracts\Sage100Api.Contracts.csproj" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.29" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <!-- Clé publique des licences, créée par deploy\licence\generer-licence.ps1 sur le poste de développement (jamais dans Git). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\lib\licence\cle-publique.xml')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\lib\licence\cle-publique.xml" LogicalName="Sage100Api.cle-publique-licence.xml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sage100Api.Tests" />
  </ItemGroup>
</Project>
